# Carregado por iniciar-dev.ps1; Spring Boot nao le .env automaticamente.
# Variaveis nao vazias ja definidas no terminal tem prioridade.
# Novo ambiente: crie o banco nextflow. Em ambiente existente, use o nome real do banco.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nextflow
DB_USERNAME=Admin
DB_PASSWORD=
# Gmail: preencha usuario, senha de app e remetente somente no .env local.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_FROM=
SESSION_COOKIE_SECURE=false
